# CyberRover X4.2 Environment Configuration Template
# Copy this file to .env or use as reference for Wi-Fi hotspot setup

# Rover Wi-Fi Telemetry Hotspot Settings
WIFI_SSID="YOUR_2_4GHZ_HOTSPOT_SSID"
WIFI_PASSWORD="YOUR_HOTSPOT_PASSWORD"

# ESP32-CAM Telemetry Hub Static/Expected IP (Optional)
ROVER_CAM_IP="192.168.43.100"
ROVER_CAM_PORT="80"
